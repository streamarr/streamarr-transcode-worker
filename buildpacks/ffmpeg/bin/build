#!/bin/bash
# shellcheck source-path=SCRIPTDIR

set -euo pipefail

layers_dir="${CNB_LAYERS_DIR:?CNB_LAYERS_DIR is required}"
target_arch="${CNB_TARGET_ARCH:?CNB_TARGET_ARCH is required}"
buildpack_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
lock_file="${buildpack_dir}/ffmpeg.lock"

# shellcheck source=../lib/http.sh
. "${buildpack_dir}/lib/http.sh"
# shellcheck source=../lib/lock.sh
. "${buildpack_dir}/lib/lock.sh"
# shellcheck source=../lib/notices.sh
. "${buildpack_dir}/lib/notices.sh"
# shellcheck source=../lib/materials.sh
. "${buildpack_dir}/lib/materials.sh"
# shellcheck source=../lib/checksum.sh
. "${buildpack_dir}/lib/checksum.sh"
# shellcheck source=../lib/runtime.sh
. "${buildpack_dir}/lib/runtime.sh"

ffmpeg_lock_validate "${lock_file}"
ffmpeg_notices_validate "${lock_file}" "${buildpack_dir}"
ffmpeg_materials_validate "${buildpack_dir}"
ffmpeg_notices_bound "${buildpack_dir}"
release="$(ffmpeg_lock_value "${lock_file}" release)"
version="$(ffmpeg_lock_value "${lock_file}" version)"
source_revision="$(ffmpeg_lock_value "${lock_file}" source_revision)"

sbom_arch="$(ffmpeg_runtime_architecture "${target_arch}")"
asset="$(ffmpeg_lock_value "${lock_file}" "${sbom_arch}_asset")"
checksum="$(ffmpeg_lock_value "${lock_file}" "${sbom_arch}_sha256")"

layer="${layers_dir}/ffmpeg"
layer_metadata="${layers_dir}/ffmpeg.toml"
cache_key="${release}/${asset}/${checksum}"

if [[ ! -x "${layer}/bin/ffmpeg" ]] || ! grep -Fq "cache_key = \"${cache_key}\"" "${layer_metadata}" 2>/dev/null; then
  rm -rf "${layer}"
  mkdir -p "${layer}/bin"
  ffmpeg_runtime_extract "${lock_file}" "${sbom_arch}" "${layer}/bin" ffmpeg ffprobe
fi

rm -rf "${layer}/env.launch"

version_output="$("${layer}/bin/ffmpeg" -version 2>&1)"
expected_runtime_version="${version%-*}-Jellyfin"
version_line="$(grep -F "ffmpeg version ${expected_runtime_version} " <<<"${version_output}" || true)"
version_line="${version_line%%$'\n'*}"
if [[ "${version_line}" != "ffmpeg version ${expected_runtime_version} "* ]]; then
  echo "Expected Jellyfin FFmpeg runtime version ${expected_runtime_version}" >&2
  exit 1
fi
grep -F -- "--enable-gpl" <<<"${version_output}" >/dev/null
if grep -Fq -- "--enable-nonfree" <<<"${version_output}"; then
  echo "FFmpeg must not include nonfree components" >&2
  exit 1
fi
ffmpeg_runtime_require_mp4_muxer_options "$("${layer}/bin/ffmpeg" -hide_banner -h muxer=mp4 2>&1)"
# The notice inventory starts from this capture, so a differing binary is unreviewed.
reviewed_buildconf="notices/buildconf-${sbom_arch}.txt"
if ! ffmpeg_runtime_buildconf "${layer}/bin/ffmpeg" \
  | cmp -s - "${buildpack_dir}/${reviewed_buildconf}"; then
  echo "FFmpeg build configuration differs from ${reviewed_buildconf}; review the notice inventory" >&2
  exit 1
fi

cp "${buildpack_dir}/LICENSE.txt" "${layer}/LICENSE.txt"
cp "${buildpack_dir}/SOURCE.txt" "${layer}/SOURCE.txt"
cp "${buildpack_dir}/generated/THIRD-PARTY-NOTICES.txt" "${layer}/THIRD-PARTY-NOTICES.txt"
rm -rf "${layer}/notices"
mkdir -p "${layer}/notices"
cp "${buildpack_dir}/notices/manifest" "${buildpack_dir}/notices/sources.json" \
  "${buildpack_dir}/notices/buildconf-amd64.txt" "${buildpack_dir}/notices/buildconf-arm64.txt" \
  "${layer}/notices/"
cp -R "${buildpack_dir}/notices/fdk-aac-stripped" "${layer}/notices/fdk-aac-stripped"

cat >"${layer_metadata}" <<EOF
[types]
launch = true
cache = true

[metadata]
cache_key = "${cache_key}"
version = "${version}"
release = "${release}"
source_revision = "${source_revision}"
EOF

cp "${buildpack_dir}/generated/ffmpeg.${sbom_arch}.cdx.json" "${layers_dir}/ffmpeg.sbom.cdx.json"
